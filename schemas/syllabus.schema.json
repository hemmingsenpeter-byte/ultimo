{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "faculty",
    "framework_status",
    "content_status",
    "year",
    "target_level",
    "extension_target_level",
    "estimated_hours",
    "prerequisites",
    "reading",
    "competencies",
    "learning_outcomes",
    "lessons",
    "assessment",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{3}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "faculty": {
      "type": "string"
    },
    "framework_status": {
      "const": "defined"
    },
    "content_status": {
      "enum": [
        "planned",
        "draft",
        "source_checked",
        "subject_reviewed",
        "pilot_tested",
        "approved",
        "published"
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "target_level": {
      "const": 2
    },
    "extension_target_level": {
      "const": 3
    },
    "estimated_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reading": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "competencies": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "learning_outcomes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "competency",
          "outcome",
          "estimated_minutes",
          "sequence",
          "prerequisite_lessons",
          "reading",
          "teaching_focus",
          "worked_example_brief",
          "practice",
          "knowledge_check",
          "evidence_criterion",
          "content_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L0[1-4]$"
          },
          "competency": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "reading": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "content_status": {
            "enum": [
              "not_authored",
              "draft",
              "source_checked",
              "subject_reviewed",
              "pilot_tested",
              "approved",
              "published"
            ]
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "artifact",
        "mode",
        "criteria",
        "threshold",
        "alternate_evidence",
        "reviewer"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "competency",
              "criterion"
            ]
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "review_required",
        "notes"
      ],
      "properties": {
        "review_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
